folio:
  okapi_url: "https://your-okapi-host.folio.example.com"
  tenant: "your_tenant"
  username: "your_service_account"
  password: "your_password"

preferences:
  # Patron group names (case-sensitive, must match FOLIO "group" field).
  # Users in these groups have delivery enabled; all others have delivery disabled.
  privileged_patron_groups:
    - "faculty"
    - "staff"
    - "graduate"
  # Address type name (case-sensitive, must match FOLIO "addressType" field).
  # Used to set defaultDeliveryAddressTypeId for privileged users who have a campus address.
  # The script resolves this to an internal ID at startup and exits if no match is found.
  campus_address_type: "Campus"

# Path to the state file (relative to this script's directory).
# Delete this file to force a full re-initialization on the next run.
state_file: "state.json"

# Maximum users per batch (init mode: per ID prefix; incremental: total). Safety
# check: if any batch returns more records than this the script exits with an error.
user_limit: 10000
